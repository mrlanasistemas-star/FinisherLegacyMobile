{
  "expo": {
    "name": "Finisher Legacy",
    "slug": "FinisherLegacyMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finisherlegacy",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.finisherlegacy.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.finisherlegacy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/images/brand/logo-mark-gold.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Finisher Legacy necesita acceso a tu cámara para escanear el código QR de tu Legacy."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Finisher Legacy necesita acceso a tus fotos para elegir la imagen de tu medalla o tu foto de perfil."
        }
      ],
      "expo-video",
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [],
          "enableGooglePay": false
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6dce084-4b31-4f64-980a-917784b1f5c3"
      }
    },
    "owner": "zuriel2026s-team"
  }
}
