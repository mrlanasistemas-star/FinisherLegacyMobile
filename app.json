{
  "expo": {
    "name": "Finisher Legacy",
    "slug": "FinisherLegacyMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finisherlegacy",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F7F3",
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.finisherlegacy.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.finisherlegacy.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.NFC",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F3",
          "image": "./assets/images/brand/fl-monograma.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Finisher Legacy usa tus fotos para que elijas imágenes y videos de tus carreras: la foto de tu medalla, tus momentos, tus recuerdos y tu foto de perfil. Solo se sube lo que tú eliges.",
          "cameraPermission": "Finisher Legacy usa la cámara para que tomes fotos de tu medalla, de tus carreras o de tu perfil cuando tú lo eliges.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Finisher Legacy usa tu ubicación solo cuando tú lo inicias: para medir la distancia de tu entrenamiento al aire libre y, si activas el seguimiento en vivo, para que las personas con las que lo compartes vean tu avance.",
          "locationAlwaysAndWhenInUsePermission": "Permite “Siempre” para que tu entrenamiento o tu seguimiento en vivo sigan midiendo aunque bloquees el teléfono. Solo se usa mientras están activos y puedes detenerlos cuando quieras.",
          "locationAlwaysPermission": "Permite “Siempre” para que tu entrenamiento o tu seguimiento en vivo sigan midiendo aunque bloquees el teléfono. Solo se usa mientras están activos.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6dce084-4b31-4f64-980a-917784b1f5c3"
      }
    },
    "owner": "zuriel2026s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6dce084-4b31-4f64-980a-917784b1f5c3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
